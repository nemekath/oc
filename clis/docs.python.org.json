{
  "domain": "docs.python.org",
  "commands": {
    "library": { "open": "https://docs.python.org/3/library/{module}.html", "args": ["module"] },
    "doc": { "open": "https://docs.python.org/3/{path}.html", "args": ["path"] },
    "search": { "sphinx": "https://docs.python.org/3/", "args": ["query"] }
  }
}
